{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dissonance-git/vgm-tooling/references/hardware/schema.json",
  "title": "VGM Tooling hardware reference evidence",
  "oneOf": [
    { "$ref": "#/$defs/source_catalog" },
    { "$ref": "#/$defs/device_reference" }
  ],
  "$defs": {
    "source_catalog": {
      "type": "object",
      "required": ["schema_version", "kind", "sources"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "hardware_source_catalog" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "artifact_filename",
        "publisher",
        "language",
        "page_count",
        "evidence_class",
        "repository_binary",
        "checksum"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "artifact_filename": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "document_date": { "type": ["string", "null"] },
        "language": { "type": "string", "minLength": 1 },
        "page_count": { "type": "integer", "minimum": 1 },
        "evidence_class": {
          "enum": ["primary_manual", "primary_development_document", "primary_schematic", "secondary_reference"]
        },
        "repository_binary": { "type": "boolean" },
        "external_locator": { "type": ["string", "null"] },
        "checksum": {
          "type": "object",
          "required": ["algorithm", "value", "status"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": ["string", "null"] },
            "status": { "enum": ["verified", "not_recorded"] }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "device_reference": {
      "type": "object",
      "required": ["schema_version", "kind", "device", "sources", "claims"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "hardware_device_reference" },
        "device": {
          "type": "object",
          "required": ["id", "name", "family"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "family": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "field",
        "value",
        "source_id",
        "pdf_page",
        "evidence_class",
        "claim_status",
        "interpretation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "source_id": { "type": "string", "minLength": 1 },
        "pdf_page": { "type": "integer", "minimum": 1 },
        "evidence_class": {
          "enum": ["primary_manual", "primary_development_document", "primary_schematic", "secondary_reference"]
        },
        "claim_status": { "enum": ["documented", "derived", "uncertain"] },
        "interpretation": { "enum": ["literal", "translated", "project_derived"] },
        "context": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
