<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Keep source-native enhancement additions outside the historical upstream
    vcxproj. MSBuild imports Directory.Build.targets after the project, so the
    original foo_input_vgm project can stay close to upstream while this repo's
    realtime engine participates in the same DLL build.
  -->
  <PropertyGroup>
    <!-- The private builder owns the audited output directory and packaging. -->
    <PostBuildEventUseInBuild>false</PostBuildEventUseInBuild>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\libvgm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        The upstream Foobar PCH includes Windows headers before project-owned
        renderer headers. Keep the Win32 min/max macros out of the entire
        translation unit so std::min, std::max and numeric_limits<T>::max()
        remain valid C++ in every generated host source.
      -->
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- WTL calls EnableThemeDialogTexture; its import owner is UxTheme.lib. -->
      <AdditionalDependencies>UxTheme.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\input_vgm_shadow.cpp" />
    <ClCompile Include="src\input_vgm_qsound_consumer.cpp" />
    <ClCompile Include="..\enhancement\genesis_state.cpp" />
    <ClCompile Include="..\enhancement\sn76489_enhanced.cpp" />
    <ClCompile Include="..\enhancement\sn76489_advance.cpp" />
    <ClCompile Include="..\enhancement\ym2612_dac_enhanced.cpp" />
    <ClCompile Include="..\enhancement\ym2612_pcm_stream.cpp" />
    <ClCompile Include="..\enhancement\ym2612_fm_timeline.cpp" />
    <ClCompile Include="..\enhancement\ym2612_hq_fm_backend.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\enhancement\vgm_command_event.h" />
    <ClInclude Include="..\enhancement\genesis_state.h" />
    <ClInclude Include="..\enhancement\sn76489_enhanced.h" />
    <ClInclude Include="..\enhancement\sn76489_enhanced_source_block.h" />
    <ClInclude Include="..\enhancement\psg_block_capture.h" />
    <ClInclude Include="..\enhancement\qsound_block_capture.h" />
    <ClInclude Include="..\enhancement\qsound_control_state.h" />
    <ClInclude Include="..\enhancement\qsound_environment_control_state.h" />
    <ClInclude Include="..\enhancement\qsound_environment_control_replay.h" />
    <ClInclude Include="..\enhancement\qsound_native_source_capture.h" />
    <ClInclude Include="..\enhancement\qsound_native_mix_capture.h" />
    <ClInclude Include="..\enhancement\qsound_native_time_map.h" />
    <ClInclude Include="..\enhancement\qsound_native_source_window.h" />
    <ClInclude Include="..\enhancement\qsound_native_linear_projection.h" />
    <ClInclude Include="..\enhancement\qsound_consumer_source_block.h" />
    <ClInclude Include="..\enhancement\qsound_consumer_source_storage.h" />
    <ClInclude Include="..\enhancement\qsound_spatial_routing_segments.h" />
    <ClInclude Include="..\enhancement\qsound_spatial_source_bus.h" />
    <ClInclude Include="..\enhancement\qsound_echo_input_recomposition.h" />
    <ClInclude Include="..\enhancement\qsound_echo_state.h" />
    <ClInclude Include="..\enhancement\qsound_reference_recomposition.h" />
    <ClInclude Include="..\enhancement\ym2612_dac_enhanced.h" />
    <ClInclude Include="..\enhancement\ym2612_dac_block_capture.h" />
    <ClInclude Include="..\enhancement\ym2612_block_capture.h" />
    <ClInclude Include="..\enhancement\ym2612_fm_backend.h" />
    <ClInclude Include="..\enhancement\ym2612_fm_timeline.h" />
    <ClInclude Include="..\enhancement\ym2612_hq_fm_profile.h" />
    <ClInclude Include="..\enhancement\ym2612_hq_fm_backend.h" />
    <ClInclude Include="..\enhancement\dac_stream_source.h" />
    <ClInclude Include="..\enhancement\ym2612_pcm_stream.h" />
    <ClInclude Include="..\enhancement\ym2612_pcm_stream_bank.h" />
    <ClInclude Include="..\enhancement\ym2612_pcm_source_queue.h" />
  </ItemGroup>
</Project>
