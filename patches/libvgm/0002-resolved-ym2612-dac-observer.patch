+void VGMPlayer::NotifyYM2612DAC(UINT32 tick, UINT8 command, UINT8 data)
+{
+	if (_commandObserver == NULL)
+		return;
+	VGM_COMMAND_OBSERVER_EVENT event;
+	event.type = VGMCOE_YM2612_DAC;
+	event.tick = tick;
+	event.filePos = _filePos;
+	event.command = command;
+	event.payload = &data;
+	event.payloadLen = 1;
+	_commandObserver(_commandObserverParam, &event);
+	return;
+}
