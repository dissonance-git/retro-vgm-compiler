+UINT8 VGMPlayer::SetQSoundSourceObserver(VGM_QSOUND_SOURCE_OBSERVER_CB cbFunc, void* cbParam)
+{
+	UINT8 hooked = 0;
+	_qsoundSourceObserver = cbFunc;
+	_qsoundSourceObserverParam = cbParam;
+
+	for (size_t curDev = 0; curDev < _devices.size(); curDev ++)
+	{
+		CHIP_DEVICE& chipDev = _devices[curDev];
+		if (chipDev.chipType != DEVID_QSOUND || chipDev.chipID >= 2)
+			continue;
+		if (chipDev.base.defInf.dataPtr == NULL || chipDev.base.defInf.devDef == NULL)
+			continue;
+		if (chipDev.base.defInf.devDef->coreID != FCC_CTR_)
+			continue;
+
+		qsoundc_set_source_callback(chipDev.base.defInf.dataPtr,
+			cbFunc != NULL ? &VGMPlayer::QSoundSourceObserverCB : NULL,
+			cbFunc != NULL ? &_qsoundSourceObserverContext[chipDev.chipID] : NULL);
+		hooked ++;
+	}
+	return hooked;
+}
+
+/*static*/ void VGMPlayer::QSoundSourceObserverCB(void* userParam, UINT64 nativeSample,
+		UINT32 sampleRate, const INT16* source)
+{
+	QSOUND_SOURCE_OBSERVER_CONTEXT* context = (QSOUND_SOURCE_OBSERVER_CONTEXT*)userParam;
+	if (context == NULL || context->player == NULL)
+		return;
+	VGMPlayer* oThis = context->player;
+	if (oThis->_qsoundSourceObserver == NULL)
+		return;
+
+	VGM_QSOUND_SOURCE_FRAME event;
+	event.chipID = context->chipID;
+	event.sampleRate = sampleRate;
+	event.nativeSample = nativeSample;
+	event.source = source;
+	event.sourceCount = VGM_QSOUND_SOURCE_COUNT;
+	oThis->_qsoundSourceObserver(oThis->_qsoundSourceObserverParam, &event);
+	return;
+}
