@@ -278,14 +285,35 @@ static void qsoundc_update(void* param, UINT32 samples, DEV_SMPL** outputs)
 	
 	if (chip->romData == NULL)
 	{
+		static const INT16 silent_sources[QSOUND_CTR_SOURCE_COUNT] = {0};
+		UINT32 silentSmpl;
+
 		memset(outputs[0], 0, samples * sizeof(*outputs[0]));
 		memset(outputs[1], 0, samples * sizeof(*outputs[1]));
+		if (chip->source_cb != NULL)
+		{
+			for (silentSmpl = 0; silentSmpl < samples; silentSmpl ++)
+			{
+				chip->source_cb(chip->source_cb_param, chip->source_sample_index,
+					chip->source_sample_rate, silent_sources);
+				chip->source_sample_index ++;
+			}
+		}
+		else
+		{
+			chip->source_sample_index += samples;
+		}
 		return;
 	}
 
 	for (curSmpl = 0; curSmpl < samples; curSmpl ++)
 	{
 		update_sample(chip);
 		outputs[0][curSmpl] = chip->out[0];
 		outputs[1][curSmpl] = chip->out[1];
+		if (chip->source_cb != NULL)
+			chip->source_cb(chip->source_cb_param, chip->source_sample_index,
+				chip->source_sample_rate, chip->voice_output);
+		chip->source_sample_index ++;
 	}
 
 	return;
 }
+
+void qsoundc_set_source_callback(void* info, QSOUND_CTR_SOURCE_CB cbFunc, void* cbParam)
+{
+	struct qsound_chip* chip = (struct qsound_chip*)info;
+	chip->source_cb = cbFunc;
+	chip->source_cb_param = cbParam;
+	return;
+}
 
