+UINT8 VGMPlayer::SetQSoundMixObserver(VGM_QSOUND_MIX_OBSERVER_CB cbFunc, void* cbParam)
+{
+	UINT8 hooked = 0;
+	_qsoundMixObserver = cbFunc;
+	_qsoundMixObserverParam = cbParam;
+
+	for (size_t curDev = 0; curDev < _devices.size(); curDev ++)
+	{
+		CHIP_DEVICE& chipDev = _devices[curDev];
+		if (chipDev.chipType != DEVID_QSOUND || chipDev.chipID >= 2)
+			continue;
+		if (chipDev.base.defInf.dataPtr == NULL || chipDev.base.defInf.devDef == NULL)
+			continue;
+		if (chipDev.base.defInf.devDef->coreID != FCC_CTR_)
+			continue;
+
+		qsoundc_set_mix_callback(chipDev.base.defInf.dataPtr,
+			cbFunc != NULL ? &VGMPlayer::QSoundMixObserverCB : NULL,
+			cbFunc != NULL ? &_qsoundSourceObserverContext[chipDev.chipID] : NULL);
+		hooked ++;
+	}
+	return hooked;
+}
+
+/*static*/ void VGMPlayer::QSoundMixObserverCB(void* userParam, UINT64 nativeSample,
+		UINT32 sampleRate, const QSOUND_CTR_MIX_FRAME* frame)
+{
+	QSOUND_SOURCE_OBSERVER_CONTEXT* context = (QSOUND_SOURCE_OBSERVER_CONTEXT*)userParam;
+	if (context == NULL || context->player == NULL || frame == NULL)
+		return;
+	VGMPlayer* oThis = context->player;
+	if (oThis->_qsoundMixObserver == NULL)
+		return;
+
+	VGM_QSOUND_MIX_FRAME event;
+	event.chipID = context->chipID;
+	event.sampleRate = sampleRate;
+	event.nativeSample = nativeSample;
+	event.echoInput = frame->echoInput;
+	event.echoOutput = frame->echoOutput;
+	for (UINT8 ch = 0; ch < 2; ch ++)
+	{
+		event.wetPostDelay[ch] = frame->wetPostDelay[ch];
+		event.dryPostDelay[ch] = frame->dryPostDelay[ch];
+		event.output[ch] = frame->output[ch];
+	}
+	oThis->_qsoundMixObserver(oThis->_qsoundMixObserverParam, &event);
+	return;
+}
