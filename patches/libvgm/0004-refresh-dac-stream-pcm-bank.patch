-			
-			// TODO: refresh DAC Stream pointers (call daccontrol_refresh_data)
+
+			// std::vector growth may move the PCM bank. Refresh every DAC stream
+			// already bound to this bank so neither libvgm nor source observers
+			// retain a stale pointer after an appended data block.
+			for (size_t curStrm = 0; curStrm < _dacStreams.size(); curStrm ++)
