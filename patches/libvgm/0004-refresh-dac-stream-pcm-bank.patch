+				DACSTRM_DEV& dacStrm = _dacStreams[curStrm];
+				if (dacStrm.bankID != (dblkType & 0x3F))
+					continue;
+				dacStrm.maxItems = (UINT32)pcmBnk->bankOfs.size();
+				daccontrol_refresh_data(dacStrm.defInf.dataPtr,
+					&pcmBnk->data[0], (UINT32)pcmBnk->data.size());
+				NotifyDACStreamSource(VGMDSE_SET_DATA, dacStrm);
+			}
 		}
 		break;
