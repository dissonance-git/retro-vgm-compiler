+void VGMPlayer::SetCommandObserver(VGM_COMMAND_OBSERVER_CB cbFunc, void* cbParam)
+{
+	_commandObserver = cbFunc;
+	_commandObserverParam = cbParam;
+	return;
+}
+
+void VGMPlayer::NotifyCommandObserver(UINT8 command)
+{
+	if (_commandObserver == NULL)
+		return;
+
+	UINT32 cmdLen = _CMD_INFO[command].cmdLen;
+	UINT32 payloadLen = 0;
+	const UINT8* payload = NULL;
+	if (cmdLen > 1 && _filePos < _fileHdr.dataEnd)
+	{
+		UINT32 bytesLeft = _fileHdr.dataEnd - _filePos;
+		if (cmdLen <= bytesLeft)
+		{
+			payload = &_fileData[_filePos + 1];
+			payloadLen = cmdLen - 1;
+		}
+	}
+
+	VGM_COMMAND_OBSERVER_EVENT event;
+	event.type = VGMCOE_COMMAND;
+	event.tick = _fileTick;
+	event.filePos = _filePos;
+	event.command = command;
+	event.payload = payload;
+	event.payloadLen = payloadLen;
+	_commandObserver(_commandObserverParam, &event);
+	return;
+}
+
+void VGMPlayer::NotifyCommandObserverReset(void)
+{
+	if (_commandObserver == NULL)
+		return;
+	VGM_COMMAND_OBSERVER_EVENT event = {VGMCOE_RESET, 0, _filePos, 0, NULL, 0};
+	_commandObserver(_commandObserverParam, &event);
+	return;
+}
