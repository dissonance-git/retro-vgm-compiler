+UINT8 qsoundc_get_echo_seed(void* info, QSOUND_CTR_ECHO_SEED* seed)
+{
+	struct qsound_chip* chip = (struct qsound_chip*)info;
+	if (chip == NULL || seed == NULL)
+		return 0xFF;
+
+	seed->lastSample = chip->echo.last_sample;
+	memcpy(seed->delayLine, chip->echo.delay_line, sizeof(seed->delayLine));
+	seed->delayPos = chip->echo.delay_pos;
+	return 0x00;
+}
