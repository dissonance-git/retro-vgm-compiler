+UINT8 VGMPlayer::GetQSoundEchoSeed(UINT8 chipID, VGM_QSOUND_ECHO_SEED* seed)
+{
+	if (seed == NULL || chipID >= 2)
+		return 0xFF;
+
+	for (size_t curDev = 0; curDev < _devices.size(); curDev ++)
+	{
+		CHIP_DEVICE& chipDev = _devices[curDev];
+		if (chipDev.chipType != DEVID_QSOUND || chipDev.chipID != chipID)
+			continue;
+		if (chipDev.base.defInf.dataPtr == NULL || chipDev.base.defInf.devDef == NULL)
+			continue;
+		if (chipDev.base.defInf.devDef->coreID != FCC_CTR_)
+			continue;
+
+		QSOUND_CTR_ECHO_SEED coreSeed;
+		UINT8 retVal = qsoundc_get_echo_seed(chipDev.base.defInf.dataPtr, &coreSeed);
+		if (retVal)
+			return retVal;
+
+		seed->lastSample = coreSeed.lastSample;
+		memcpy(seed->delayLine, coreSeed.delayLine, sizeof(seed->delayLine));
+		seed->delayPos = coreSeed.delayPos;
+		return 0x00;
+	}
+
+	return 0x01;
+}
