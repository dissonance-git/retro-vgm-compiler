+void VGMPlayer::SetDACStreamSourceObserver(VGM_DAC_STREAM_SOURCE_CB cbFunc, void* cbParam)
+{
+	_dacStreamObserver = cbFunc;
+	_dacStreamObserverParam = cbParam;
+	return;
+}
+
+void VGMPlayer::NotifyDACStreamSource(UINT8 type, const DACSTRM_DEV& stream,
+		UINT32 startOffset, UINT32 length)
+{
+	if (_dacStreamObserver == NULL)
+		return;
+
+	VGM_DAC_STREAM_SOURCE_EVENT event;
+	event.type = type;
+	event.tick = _fileTick;
+	event.streamID = stream.streamID;
+	event.chipType = stream.chipType;
+	event.chipID = stream.chipID;
+	event.chipCommand = stream.chipCommand;
+	event.bankID = stream.bankID;
+	event.stepSize = stream.stepSize;
+	event.stepBase = stream.stepBase;
+	event.playMode = stream.pbMode;
+	event.frequency = stream.freq;
+	event.startOffset = startOffset;
+	event.length = length;
+	event.data = NULL;
+	event.dataLen = 0;
+	if (stream.bankID < _PCM_BANK_COUNT)
+	{
+		const PCM_BANK& bank = _pcmBank[stream.bankID];
+		if (! bank.data.empty())
+		{
+			event.data = &bank.data[0];
+			event.dataLen = (UINT32)bank.data.size();
+		}
+	}
+	_dacStreamObserver(_dacStreamObserverParam, &event);
+	return;
+}
+
 void VGMPlayer::NotifyCommandObserver(UINT8 command)
 {
